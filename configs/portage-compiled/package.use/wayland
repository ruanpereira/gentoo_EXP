# /etc/portage/package.use/wayland
games-util/mangohud wayland
# Necessário para satisfazer a dependência do mesa com USE=X (GLX/OpenGL para XWayland)
# Sem isso: emerge falha com "no ebuilds built with USE flags to satisfy libglvnd[X]"
media-libs/libglvnd X
# Necessário para satisfazer a dependência do pango (utilizado pelo Niri)
media-libs/freetype harfbuzz png
# Necessário para satisfazer a dependência do GTK4 / Pavucontrol
x11-libs/cairo X
# Habilitar suporte nativo a screencast no Niri para OBS, Discord/Vesktop e navegadores
gui-wm/niri screencast
# Necessário para geração de documentação e manpages do ecossistema Wayland
app-text/xmlto text
